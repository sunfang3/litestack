<section aria-labelledby="litedb-heading"><h2 id="litedb-heading">Litedb</h2>
<% if @empty_state %><div class="lb-empty" role="status"><p><strong>No Litedb metrics yet.</strong></p></div><% end %>
  <div class = "row">

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Size
        </div>
        <div class="card-body">
          <h1><%=round(@size)%>MB</h1>
        </div>
      </div>
    </div>

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Tables
        </div>
        <div class="card-body">
          <h1><%=@tables%></h1>
        </div>
      </div>
    </div>

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Indexes
        </div>
        <div class="card-body">
          <h1><%=@indexes%></h1>
        </div>
      </div>
    </div>

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Read queries
        </div>
        <div class="card-body">
          <h1><%=format(@reads)%></h1>
        </div>
      </div>
    </div>

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Write queries
        </div>
        <div class="card-body">
          <h1><%=format(@writes)%></h1>
        </div>
      </div>
    </div>


  </div>

  <div class = "row">
  &nbsp;<br/>
  </div>

  <div class = "row">

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Reads vs writes over time
        </div>
        <div class="card-body">
          <div class="inlinecolumn" data-label="Reads vs writes over time" data-chart-json="<%= h(json_data([["Time", "Reads", "Writes"]] + Array(@reads_vs_writes))) %>"></div>
        </div>
      </div>
    </div>

    <div class = "col-6">
      <div class="card">
        <div class="card-header">
          Reads vs writes
        </div>
        <div class="card-body">
          <div class="inlinepie" data-label="Reads vs writes" data-chart-json="<%= h(json_data([["name", "value"], ["reads", @reads.to_i], ["writes", @writes.to_i]])) %>"></div>
        </div>
      </div>
    </div>
  
  </div>
  
  <div class = "row">
  &nbsp;<br/>
  </div>

  <div class = "row">

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Query execution time over time
        </div>
        <div class="card-body">
          <div class="inlinecolumn" data-label="Query execution time" data-chart-json="<%= h(json_data([["Time", "Reads execution time", "Writes execution time"]] + Array(@reads_vs_writes_times).map { |r| Array(r).first(3) })) %>"></div>
        </div>
      </div>
    </div>

    <div class = "col-6">
      <div class="card">
        <div class="card-header">
          Query time
        </div>
        <div class="card-body">
          <div class="inlinepie" data-label="Query time" data-chart-json="<%= h(json_data([["name", "value"], ["total reads time", @read_times.to_f], ["total writes time", @write_times.to_f]])) %>"></div>
        </div>
      </div>
    </div>
  
  </div>
  
  <div class = "row">
  &nbsp;<br/>
  </div>

  <div class = "row">

    <div class = "col-6">
      <div class="card">
        <div class="card-header">
          Slowest queries
        </div>
        <div class="card-body">
          <table class="table">
            <%@slowest.each do |r| %>
            <tr>
              <td><%=r['key']%></td>
              <td align="right"><h6><%=format(r['ravg'].truncate(4))%>&nbsp;sec</h6></td>
            </tr>
            <% end %>
          </table>
        </div>
      </div>
    </div>

    <div class = "col-6">
      <div class="card">
        <div class="card-header">
          Most expensive queries (execution time x frequency)
        </div>
        <div class="card-body">
          <table class="table">
            <%@popular.each do |r| %>
            <tr>
              <td><%=r['key']%></td>
              <td align="right"><h6><%=format(r['rtotal'].truncate(4))%>&nbsp;sec</h6></td>
            </tr>
            <% end %>
          </table>
        </div>
      </div>
    </div>

  </div>

  <div class = "row">
  &nbsp;<br/>
  </div>

</section>
