<section aria-labelledby="litecache-heading">
  <h2 id="litecache-heading">Litecache</h2>
  <% if @empty_state %>
    <div class="lb-empty" role="status"><p><strong>No Litecache metrics yet.</strong> Enable metrics and generate cache traffic.</p></div>
  <% end %>
  <div class="lb-metric"><strong><%= format(round(@size)) %> MB / <%= format(round(@max_size)) %> MB</strong><span>size / max (<%= round(@full) %>% full)</span></div>
  <div class="lb-metric"><strong><%= format(@entries) %></strong><span>entries</span></div>
  <div class="lb-metric"><strong><%= format(@reads) %> / <%= format(@writes) %></strong><span>reads / writes</span></div>

  <div class = "row">

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Current size / Max size
        </div>
        <div class="card-body">
          <h1><%=format(round(@size))%>MB / <%=format(round(@max_size))%>MB <span class="fs-4"><%=round(@full)%>% full</span></h1>
        </div>
      </div>
    </div>

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Number of entries
        </div>
        <div class="card-body">
          <h1><%=format(@entries)%></h1>
        </div>
      </div>
    </div>

  </div>

  <div class = "row">
  &nbsp;<br/>
  </div>

  <div class = "row">

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Reads / Writes
        </div>
        <div class="card-body">
          <h1><%=format(@reads)%> / <%=format(@writes)%> <span class="fs-4"><%=round(@reads.to_f/@writes) rescue 0%> reads/write</span></h1>
          <hr/>
          <div class="inlinepie" data-label="Reads / Writes" data-chart-json="<%= h(json_data([["name", "value"], ["reads", @reads.to_i], ["writes", @writes.to_i]])) %>"></div>
        </div>
      </div>
    </div>

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Read hits / Misses
        </div>
        <div class="card-body">
          <h1><%=format(@hits)%> / <%=format(@misses)%> <span class="fs-4"><%=round(@hitrate*100)%>% hit rate</span></h1>
          <hr/>
          <div class="inlinepie" data-label="Hits / Misses" data-chart-json="<%= h(json_data([["name", "value"], ["hits", @hits.to_f], ["misses", @misses.to_f]])) %>"></div>
        </div>
      </div>
    </div>

  </div>

  <div class = "row">
  &nbsp;<br/>
  </div>

  <div class = "row">

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Reads, writes over time
        </div>
        <div class="card-body">
          <div class="inlinecolumn" data-label="Reads, writes over time" data-chart-json="<%= h(json_data([["Time", "Reads", "Writes"]] + Array(@reads_vs_writes))) %>"></div>
        </div>
      </div>
    </div>

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Hits vs misses over time
        </div>
        <div class="card-body">
          <div class="inlinecolumn" data-label="Hits vs misses over time" data-chart-json="<%= h(json_data([["Time", "Hits", "Misses"]] + Array(@hits_vs_misses))) %>"></div>
        </div>
      </div>
    </div>

  </div>

  <div class = "row">
  &nbsp;<br/>
  </div>

  <div class = "row">

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Most read entries
        </div>
        <div class="card-body">
          <table class="table">
            <%@top_reads.each do |r| %>
            <tr>
              <td><%=r['key']%></td>
              <td align="right"><h5><%=format(r['rcount'])%></h5></td>
            </tr>
            <% end %>
          </table>
        </div>
      </div>
    </div>

    <div class = "col">
      <div class="card">
        <div class="card-header">
          Most written entries
        </div>
        <div class="card-body">
          <table class="table">
            <%@top_writes.each do |r| %>
            <tr>
              <td><%=r['key']%></td>
              <td align="right"><h5><%=format(r['rcount'])%></h5></td>
            </tr>
            <% end %>
          </table>
        </div>
      </div>
    </div>

  </div>

  <div class = "row">
  &nbsp;<br/>
  </div>


